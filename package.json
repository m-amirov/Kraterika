{
  "name": "kraterika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Кратерика — 2D лунная логистика и развитие колонии",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "verify:contracts": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
